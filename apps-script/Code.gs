function deleteById_(sheetName,idHeader,id,warehouseCode){const name=warehouseCode?warehouseSheetName_(warehouseCode,sheetName):sheetName,sh=db_().getSheetByName(name);if(!sh||sh.getLastRow()<2)throw new Error('Record not found.');const values=sh.getDataRange().getDisplayValues(),col=values[0].indexOf(idHeader);if(col<0)throw new Error('Record ID column is missing.');for(let i=values.length-1;i>0;i--)if(String(values[i][col])===String(id)){sh.deleteRow(i+1);return true;}throw new Error('Record not found.');}
